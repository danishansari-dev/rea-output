# Project Zara - Clean Room Git Ignore
# Why this exists: Prevents committing ephemeral bytecode, local SQLite databases, 
# test caches, and large voice training checkpoints/datasets to git repository.

# Python compiled bytecode
__pycache__/
*.py[cod]
*$py.class

# Pytest and testing caches
.pytest_cache/
.coverage
htmlcov/

# Local databases and locks
*.db
*.db-shm
*.db-wal

# Voice training datasets and model checkpoints (prevent committing multi-GB weights)
training/voice/datasets/
training/voice/checkpoints/
*.safetensors
*.pt
*.bin
*.onnx

# Environment variables and secrets
.env
.env.*
*.local
