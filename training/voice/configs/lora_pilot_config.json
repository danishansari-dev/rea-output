{
  "experiment_name": "zara_voice_pilot_lora_v1",
  "base_model": "rumik-ai/rumik-oss-1",
  "audio_codec": "kyutai/mimi",
  "sample_rate": 24000,
  "rvq_codebooks": 8,
  "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"],
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "learning_rate": 0.0002,
  "min_learning_rate": 0.00001,
  "lr_scheduler_type": "cosine",
  "warmup_ratio": 0.06,
  "weight_decay": 0.01,
  "per_device_train_batch_size": 2,
  "gradient_accumulation_steps": 8,
  "effective_batch_size": 16,
  "fp16": true,
  "bf16": false,
  "gradient_checkpointing": true,
  "max_grad_norm": 1.0,
  "num_train_epochs": 5,
  "logging_steps": 10,
  "save_strategy": "epoch",
  "save_total_limit": 2
}
